loops_root {} [
	names {} [
		@foreach (var name in Names) {
			name_item { text: "{name}" }
		@}
	]
	items {} [
		@foreach (var item in Items) key (item.Id) {
			item_row { text: "{item.Name}" }
		@}
	]
	host<RecordingHost> {} [
		@foreach (var name in Names) {
			host_row { text: "{name}" }
		@}
	]
	shouted {} [
		@foreach (var name in Shouted) {
			shouted_item { text: "{name}" }
		@}
	]
	shouted_keyed {} [
		@foreach (var name in Shouted) key (name) {
			shouted_keyed_item { text: "{name}" }
		@}
	]
	shouted_host<RecordingHost> {} [
		@foreach (var name in Shouted) {
			shouted_row { text: "{name}" }
		@}
	]
]
