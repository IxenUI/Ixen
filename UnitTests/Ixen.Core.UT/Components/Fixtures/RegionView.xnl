region_root {} [
	region_before { text: "before" }
	@if (ShowTitle) {
		region_title { text: "{Title}" }
		region_subtitle { text: "sub" }
	@}
	region_middle { text: "middle" }
	@if (ShowFooter) {
		region_footer { text: "footer" click: "{Bump()}" }
	@}
	region_after { text: "after" }
	@if (Level == 1) {
		level_one { text: "one" }
	@} else if (Level == 2) {
		level_two { text: "two" }
	@} else {
		level_other { text: "other" }
	@}
]
