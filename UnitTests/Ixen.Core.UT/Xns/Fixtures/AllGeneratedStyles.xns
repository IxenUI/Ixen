generated_root {
    layout: row
    width: ?
    height: ?
    background: #FF0000 Assets/Images/logo.png repeat-x bottom  // a path, a keyword and a position
    border: #CCCCCC 1.5px inner
    corner-radius: 8.5px 4px 2px 1px
    color: #123456
    font-family: Segoe UI
    font-size: 13.5px
    font-weight: bold
    font-style: italic
    margin: 1.5px 2px
    padding: 3px 4.25px 5px 6px
    row-template: 1.5* 20.5px
    column-template: 30% 2.5*
    text-align: right bottom
    text-overflow: ellipsis
    text-wrap: nowrap
    transition: background 150ms color 0.2s 30ms ease-out
    cursor: hand
    object-fit: scale-down
    overflow: scroll
    animation: generated_pulse 480ms ease-out 60ms infinite alternate

    generated_child {
        width: 30.5%
        height: 20px
        left: 1.5px
        top: 25%
        right: 3px
        bottom: 4.25px
        dock: right
        column-index: 1
        row-index: 2
        column-span: 2
        row-span: 3
    }

    generated_child:hover {
        width: 5px
    }

    generated_sides {
        border: #445566 0px 1px 2.5px 3px inner
    }
}

@keyframes generated_pulse {
    0%   { background: #FF0000  width: 10px }
    50%  { background: #00FF00 }
    100% { background: #0000FF  width: 30.5px }
}