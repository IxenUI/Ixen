<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Copyright>©2026 by kipy</Copyright>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<PackageId>Ixen.Platform.Desktop</PackageId>
		<Version>0.0.1</Version>
		<Authors>kipy</Authors>
		<Description>The desktop hosts for Ixen. Reference this from one application and it runs on every desktop platform Ixen supports; the host is chosen at run time.</Description>
		<PackageTags>ixen;ui;desktop</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\Ixen.Platform\Ixen.Platform.csproj" />
		<ProjectReference Include="..\Ixen.Platform.Windows\Ixen.Platform.Windows.csproj" />
		<ProjectReference Include="..\Ixen.Platform.Mac\Ixen.Platform.Mac.csproj" />
		<ProjectReference Include="..\Ixen.Platform.Linux\Ixen.Platform.Linux.csproj" />
	</ItemGroup>

</Project>
