{
  "$schema": "http://json.schemastore.org/template",
  "author": "kipy",
  "classifications": [ "Ixen", "UI", "Desktop" ],
  "identity": "Ixen.Templates.DesktopApp",
  "name": "Ixen desktop application",
  "shortName": "ixen",
  "description": "A window that runs on Windows, macOS and Linux: one view in XNL, one stylesheet in XNS, and a component binding them together.",
  "sourceName": "IxenApp",
  "defaultName": "IxenApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "IxenVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.0.1",
      "replaces": "0.0.1",
      "description": "The version of the Ixen packages to reference."
    },
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target net10.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0",
      "description": "The target framework for the project."
    }
  }
}
