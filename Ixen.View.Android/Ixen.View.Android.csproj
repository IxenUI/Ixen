<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Copyright>©2026 by kipy</Copyright>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<PackageId>Ixen.View.Android</PackageId>
		<Version>0.0.1</Version>
		<Authors>kipy</Authors>
		<Description>The Android view for Ixen: an IxenView to place in an activity, with touch and multi-touch, the keyboards, composition, the back gesture, the clipboard and TalkBack.</Description>
		<PackageTags>ixen;ui;android</PackageTags>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
		<PackageReference Include="SkiaSharp.Views" Version="4.151.1" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\Ixen.Platform\Ixen.Platform.csproj" />
	</ItemGroup>
</Project>