<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Copyright>©2026 by kipy</Copyright>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<PackageId>Ixen.Platform.Mac</PackageId>
		<Version>0.0.1</Version>
		<Authors>kipy</Authors>
		<Description>The macOS host for Ixen. Reference this from a macOS application; it carries the native window library.</Description>
		<PackageTags>ixen;ui;macos</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\Ixen.Platform\Ixen.Platform.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<IxenMacRuntime Condition="'$(IxenMacRuntime)' == ''">osx-arm64</IxenMacRuntime>
		<IxenMacDylib>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Ixen.Platform.Mac.Native', 'bin', 'libixen.dylib'))</IxenMacDylib>
	</PropertyGroup>

	<Target Name="IxenIncludeMacLibrary" BeforeTargets="AssignTargetPaths">
		<Warning Condition="!Exists('$(IxenMacDylib)') And $([MSBuild]::IsOSPlatform('OSX'))"
				 Code="IXEN002"
				 Text="libixen.dylib was not found at $(IxenMacDylib), so it will not be copied next to the application and every window call will fail with DllNotFoundException. Build it on macOS with Ixen.Platform.Mac.Native/build-mac-native.sh - no MSBuild target can produce it." />
		<ItemGroup Condition="Exists('$(IxenMacDylib)')">
			<Content Include="$(IxenMacDylib)">
				<Link>libixen.dylib</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				<Visible>false</Visible>
				<Pack>true</Pack>
				<PackagePath>runtimes/$(IxenMacRuntime)/native</PackagePath>
			</Content>
		</ItemGroup>
	</Target>

</Project>
