<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <ShouldIncludeNativeSkiaSharp>True</ShouldIncludeNativeSkiaSharp>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Copyright>©2026 by kipy</Copyright>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<PackageId>Ixen.Platform.Windows</PackageId>
		<Version>0.0.1</Version>
		<Authors>kipy</Authors>
		<Description>The Win32 host for Ixen. Reference this from a Windows application; it carries the native window library.</Description>
		<PackageTags>ixen;ui;win32</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

	<PropertyGroup>
		<IxenNativePlatform Condition="'$(IxenNativePlatform)' == ''">x64</IxenNativePlatform>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
	</ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\Ixen.Platform\Ixen.Platform.csproj" />
		<ProjectReference Include="..\Ixen.Platform.Windows.Native\Ixen.Platform.Windows.Native.vcxproj"
							  Properties="Platform=$(IxenNativePlatform)">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
    </ItemGroup>

	<PropertyGroup>
		<IxenNativePlatform Condition="'$(IxenNativePlatform)' == ''">x64</IxenNativePlatform>
		<IxenNativeDll>$(MSBuildThisFileDirectory)..\Ixen.Platform.Windows.Native\bin\$(IxenNativePlatform)\$(Configuration)\Ixen.Platform.Windows.Native.dll</IxenNativeDll>
	</PropertyGroup>

	<Target Name="IxenIncludeNativeLibrary" BeforeTargets="AssignTargetPaths">
		<Warning Condition="!Exists('$(IxenNativeDll)')"
				 Code="IXEN001"
				 Text="Ixen.Platform.Windows.Native.dll was not found at $(IxenNativeDll), so it will not be copied next to the application and every window call will fail with DllNotFoundException. Build it with MSBuild.exe or Visual Studio - the dotnet CLI cannot build a .vcxproj (MSB4278)." />
		<ItemGroup Condition="Exists('$(IxenNativeDll)')">
			<Content Include="$(IxenNativeDll)">
				<Link>Ixen.Platform.Windows.Native.dll</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				<Visible>false</Visible>
				<Pack>true</Pack>
				<PackagePath>runtimes/win-$(IxenNativePlatform)/native</PackagePath>
			</Content>
		</ItemGroup>
	</Target>

</Project>
