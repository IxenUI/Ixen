<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="Main/MainView.xnl" />
		<AdditionalFiles Include="Main/MainStyles.xns" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\..\Ixen.Controls\Ixen.Controls.csproj" />
		<ProjectReference Include="..\..\Ixen.Platform\Ixen.Platform.csproj" />
		<ProjectReference Include="..\..\Ixen.Platform.Desktop\Ixen.Platform.Desktop.csproj" />
		<ProjectReference Include="..\..\Ixen.Generators\Ixen.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
