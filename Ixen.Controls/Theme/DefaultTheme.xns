$surface:      #F4F5F8
$surface_over: #E8EAF0
$surface_down: #DCDFE8
$surface_off:  #F0F1F4
$line:         #C3C8D4
$line_off:     #DDE0E8
$text:         #1F2430
$text_off:     #A0A6B4
$focus:        #4C6EF5

#Button {
    width: ?
    height: ?
    background: $surface
    border: $line 1px inner
    corner-radius: 5px
    padding: 7px 14px
    color: $text
    font-size: 13px
    text-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#Button:hover,
#MenuItem:hover,
#TabHeader:focus,
#TreeRow:hover,
#DataGridHeaderCell:hover,
#DataGridHeaderCell:focus,
#DataGridRow:hover,
#DatePickerPrevious:hover,
#DatePickerNext:hover,
#DatePickerDay:hover {
    background: $surface_over
}

#Button:pressed {
    background: $surface_down
}

#Button:focus,
#CheckBox:hover,
#CheckBox:focus,
#RadioButton:hover,
#RadioButton:checked,
#RadioButton:focus,
#Switch:hover,
#Switch:focus,
#ComboBox:hover,
#ComboBox:focus,
#TreeView:focus,
#DataGrid:focus,
#DatePicker:focus,
#DatePickerDay:today {
    border: $focus 1px inner
}

#Button:disabled,
#CheckBox:disabled,
#RadioButton:disabled,
#ComboBox:disabled,
#DatePicker:disabled {
    background: $surface_off
    border: $line_off 1px inner
    color: $text_off
    cursor: not-allowed
}

#CheckBox {
    width: 18px
    height: 18px
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 3px
    content-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#CheckBoxMark {
    width: 10px
    height: 10px
    background: $focus
    corner-radius: 2px
    visibility: hidden
}

#CheckBoxMark:checked,
#RadioButtonMark:checked,
#TabItem:selected,
#DataGridSortMark:sorted {
    visibility: visible
}

#CheckBox:checked {
    background: #EEF1FE
    border: $focus 1px inner
}

#RadioButton {
    width: 18px
    height: 18px
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 9px
    content-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#RadioButtonMark {
    width: 8px
    height: 8px
    background: $focus
    corner-radius: 4px
    visibility: hidden
}

#Switch {
    width: 34px
    height: 18px
    background: $surface_down
    border: $line 1px inner
    corner-radius: 9px
    padding: 2px
    content-align: left middle
    cursor: hand
    transition: background 140ms ease-out
}

#SwitchKnob {
    width: 12px
    height: 12px
    background: #FFFFFF
    corner-radius: 6px
}

#Switch:checked {
    background: $focus
    border: $focus 1px inner
    content-align: right middle
}

#Switch:disabled {
    background: $surface_off
    border: $line_off 1px inner
    cursor: not-allowed
}

#Menu {
    z-index: 10
}

#MenuPanel {
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 6px
    padding: 4px
    box-shadow: 0px 6px 18px #30000000
}

#MenuItem {
    height: ?
    padding: 6px 14px
    corner-radius: 4px
    color: $text
    font-size: 13px
    text-align: left middle
    cursor: hand
}

#MenuItem:horizontal {
    width: ?
}

#MenuItem:focus {
    background: #EEF1FE
}

#MenuItem:disabled {
    color: $text_off
    cursor: not-allowed
}

#ComboBox {
    layout: row
    width: ?
    height: ?
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 5px
    padding: 7px 12px
    color: $text
    font-size: 13px
    content-align: middle
    cursor: hand
    transition: background 120ms ease-out
}

#ComboBoxLabel {
    width: ?
    height: ?
    text-align: left middle
}

#ComboBox:open {
    border: $focus 1px inner
    background: #FCFCFE
}

#ComboBoxChevron {
    width: ?
    height: ?
    margin: 0px 0px 0px 10px
    color: $text_off
    font-size: 9px
    text-align: center middle
}

#MenuItem:submenu {
    background: #F2F4FE
}

#MenuBar {
    width: 1*
    height: ?
    background: $surface
    border: $line 0px 0px 1px 0px inner
    padding: 2px 6px
    gap: 2px
}

@keyframes ixen_spin {
    0%   { transform: rotate(0deg) }
    100% { transform: rotate(360deg) }
}

@keyframes ixen_busy {
    0%   { left: 0%   width: 20% }
    50%  { left: 40%  width: 40% }
    100% { left: 100% width: 20% }
}

#Slider {
    width: 176px
    height: 18px
    padding: 0px 16px 0px 0px
    cursor: hand
}

#Slider:disabled {
    cursor: not-allowed
}

#SliderTrack {
    top: 7px
    height: 4px
    background: $surface_down
    corner-radius: 2px
}

#SliderFill {
    top: 7px
    height: 4px
    background: $focus
    corner-radius: 2px
}

#SliderThumb {
    top: 1px
    width: 16px
    height: 16px
    background: #FFFFFF
    border: $focus 2px inner
    corner-radius: 8px
    transition: border 120ms ease-out
}

#ProgressBar {
    width: 160px
    height: 6px
    background: $surface_down
    corner-radius: 3px
}

#ProgressBarFill {
    top: 0px
    height: 6px
    background: $focus
    corner-radius: 3px
}

#ProgressBarFill:busy {
    animation: ixen_busy 1200ms ease-in-out infinite
}

#Spinner {
    width: 16px
    height: 16px
    animation: ixen_spin 900ms linear infinite
}

#SpinnerDot {
    left: 6px
    top: 0px
    width: 4px
    height: 4px
    background: $focus
    corner-radius: 2px
}

#TabControl,
#DataGridBody {
    width: 1*
    height: 1*
}

#TabStrip {
    width: 1*
    height: ?
    border: $line 0px 0px 1px 0px inner
    gap: 2px
    padding: 0px 4px
}

#TabHeader {
    width: ?
    height: ?
    padding: 8px 16px
    color: $text_off
    font-size: 13px
    text-align: center middle
    corner-radius: 6px 6px 0px 0px
    cursor: hand
    transition: background 120ms ease-out
}

#TabHeader:hover {
    background: $surface_over
    color: $text
}

#TabHeader:selected {
    background: $surface
    border: $focus 0px 0px 2px 0px inner
    color: $text
}

#TabHeader:disabled,
#DatePickerDay:disabled {
    color: $line_off
    cursor: not-allowed
}

#TabContent {
    width: 1*
    height: 1*
    padding: 12px 4px
}

#TabItem,
#TreeExpander:leaf {
    visibility: hidden
}

#TooltipPanel {
    width: ?
    height: ?
    max-width: 260px
    background: #1F2430
    corner-radius: 5px
    padding: 6px 10px
    margin: 0px 0px 6px 0px
    color: #FFFFFF
    font-size: 12px
    box-shadow: 0px 4px 14px #40000000
}

#DialogScrim {
    background: #99101216
    content-align: center middle
}

#DialogSheet {
    min-width: 280px
    max-width: 460px
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 10px
    padding: 20px
    gap: 12px
    color: $text
    box-shadow: 0px 12px 36px #50000000
}

#TreeView,
#DataGrid {
    width: 1*
    height: 1*
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 5px
}

#TreeRows {
    width: 1*
    height: 1*
    padding: 4px
}

#TreeRow {
    text-align: left middle
    color: $text
    font-size: 13px
    corner-radius: 4px
    cursor: hand
    transition: background 100ms ease-out
}

#TreeRow:selected,
#DataGridRow:selected,
#DatePickerDay:selected {
    background: $focus
    color: #FFFFFF
}

#TreeExpander {
    width: 14px
    height: 1*
    font-size: 7px
    text-align: center middle
    opacity: 0.6
    transform: rotate(-90deg)
    transition: transform 120ms ease-out
}

#TreeExpander:expanded,
#DataGridSortMark:descending {
    transform: rotate(0deg)
}

#DataGridHeader {
    width: 1*
    height: 30px
    padding: 0px 14px 0px 0px
    background: $surface
    border: $line 0px 0px 1px 0px inner
}

#DataGridHeaderCell {
    height: 1*
    padding: 0px 10px
    color: $text_off
    font-size: 12px
    cursor: hand
    transition: background 100ms ease-out
}

#DataGridHeaderCell:sorted {
    color: $text
}

#DataGridHeaderLabel {
    width: 1*
    height: 1*
    text-align: left middle
}

#DataGridSortMark {
    width: 10px
    height: 1*
    font-size: 7px
    text-align: center middle
    opacity: 0.6
    visibility: hidden
    transform: rotate(180deg)
}

#DataGridRow {
    color: $text
    font-size: 13px
    cursor: hand
}

#DataGridCell {
    height: 1*
    padding: 0px 10px
    text-align: left middle
}

#DatePicker {
    width: ?
    height: ?
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 5px
    padding: 7px 12px
    color: $text
    font-size: 13px
    content-align: middle
    gap: 10px
    cursor: hand
}

#DatePicker:hover {
    background: $surface
}

#DatePickerLabel {
    width: 90px
    text-align: left middle
}

#DatePickerChevron {
    font-size: 7px
    opacity: 0.6
}

#DatePickerCalendar {
    width: 224px
    height: ?
    gap: 4px
}

#DatePickerNav {
    width: 1*
    height: 26px
}

#DatePickerTitle {
    width: 1*
    height: 1*
    color: $text
    font-size: 13px
    font-weight: bold
    text-align: center middle
}

#DatePickerPrevious {
    width: 24px
    height: 1*
    font-size: 7px
    text-align: center middle
    color: $text_off
    corner-radius: 4px
    cursor: hand
    transform: rotate(90deg)
}

#DatePickerNext {
    width: 24px
    height: 1*
    font-size: 7px
    text-align: center middle
    color: $text_off
    corner-radius: 4px
    cursor: hand
    transform: rotate(-90deg)
}

#DatePickerWeek {
    width: 1*
    height: 22px
}

#DatePickerWeekday {
    width: 1*
    height: 1*
    color: $text_off
    font-size: 11px
    text-align: center middle
}

#DatePickerDays {
    width: 1*
    height: ?
    row-template: 1* 1* 1* 1* 1* 1* 1*
}

#DatePickerDay {
    width: 1*
    height: 28px
    color: $text
    font-size: 12px
    text-align: center middle
    corner-radius: 4px
    cursor: hand
    transition: background 100ms ease-out
}

#DatePickerDay:outside {
    color: $line_off
}

