$surface:      #F4F5F8
$surface_over: #E8EAF0
$surface_down: #DCDFE8
$surface_off:  #F0F1F4
$line:         #C3C8D4
$line_off:     #DDE0E8
$text:         #1F2430
$text_off:     #A0A6B4
$focus:        #4C6EF5

#Button {
    width: ?
    height: ?
    background: $surface
    border: $line 1px inner
    corner-radius: 5px
    padding: 7px 14px
    color: $text
    font-size: 13px
    text-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#Button:hover {
    background: $surface_over
}

#Button:pressed {
    background: $surface_down
}

#Button:focus {
    border: $focus 1px inner
}

#Button:disabled {
    background: $surface_off
    border: $line_off 1px inner
    color: $text_off
    cursor: default
}

#CheckBox {
    width: 18px
    height: 18px
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 3px
    color: $focus
    font-size: 12px
    text-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#CheckBox:hover {
    border: $focus 1px inner
}

#CheckBox:checked {
    background: #EEF1FE
    border: $focus 1px inner
}

#CheckBox:focus {
    border: $focus 1px inner
}

#CheckBox:disabled {
    background: $surface_off
    border: $line_off 1px inner
    color: $text_off
    cursor: default
}

#RadioButton {
    width: 18px
    height: 18px
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 9px
    color: $focus
    font-size: 10px
    text-align: center middle
    cursor: hand
    transition: background 120ms ease-out
}

#RadioButton:hover {
    border: $focus 1px inner
}

#RadioButton:checked {
    border: $focus 1px inner
}

#RadioButton:focus {
    border: $focus 1px inner
}

#RadioButton:disabled {
    background: $surface_off
    border: $line_off 1px inner
    color: $text_off
    cursor: default
}

#Switch {
    width: 34px
    height: 18px
    background: $surface_down
    border: $line 1px inner
    corner-radius: 9px
    cursor: hand
    transition: background 140ms ease-out
}

#Switch:hover {
    border: $focus 1px inner
}

#Switch:checked {
    background: $focus
    border: $focus 1px inner
}

#Switch:focus {
    border: $focus 1px inner
}

#Switch:disabled {
    background: $surface_off
    border: $line_off 1px inner
    cursor: default
}

#Menu {
    z-index: 10
}

#MenuPanel {
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 6px
    padding: 4px
    box-shadow: 0px 6px 18px #30000000
}

#MenuItem {
    width: ?
    height: ?
    padding: 6px 14px
    corner-radius: 4px
    color: $text
    font-size: 13px
    text-align: left middle
    cursor: hand
}

#MenuItem:hover {
    background: $surface_over
}

#MenuItem:focus {
    background: #EEF1FE
}

#MenuItem:disabled {
    color: $text_off
    cursor: default
}

#ComboBox {
    layout: row
    width: ?
    height: ?
    background: #FFFFFF
    border: $line 1px inner
    corner-radius: 5px
    padding: 7px 12px
    color: $text
    font-size: 13px
    content-align: middle
    cursor: hand
    transition: background 120ms ease-out
}

#ComboBoxLabel {
    width: ?
    height: ?
    text-align: left middle
}

#ComboBox:hover {
    border: $focus 1px inner
}

#ComboBox:focus {
    border: $focus 1px inner
}

#ComboBox:open {
    border: $focus 1px inner
    background: #FCFCFE
}

#ComboBox:disabled {
    background: $surface_off
    border: $line_off 1px inner
    color: $text_off
    cursor: default
}

#ComboBoxChevron {
    width: ?
    height: ?
    margin: 0px 0px 0px 10px
    color: $text_off
    font-size: 9px
    text-align: center middle
}

#MenuItem:submenu {
    background: #F2F4FE
}

#MenuBar {
    width: 1*
    height: ?
    background: $surface
    border: $line 0px 0px 1px 0px inner
    padding: 2px 6px
    gap: 2px

    #MenuItem {
        padding: 5px 10px
    }
}
