<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Copyright>©2026 by kipy</Copyright>
		<AssemblyVersion>0.0.1</AssemblyVersion>
		<FileVersion>0.0.1</FileVersion>
		<PackageId>Ixen.View.iOS</PackageId>
		<Version>0.0.1</Version>
		<Authors>kipy</Authors>
		<Description>The iOS and Mac Catalyst view for Ixen: an IxenView to place in a UIKit hierarchy, with touch, both keyboards, composition, a pointer, drops and VoiceOver.</Description>
		<PackageTags>ixen;ui;ios;maccatalyst</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
		<PackageReference Include="SkiaSharp.Views" Version="4.151.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ixen.Core\Ixen.Core.csproj" />
		<ProjectReference Include="..\Ixen.Platform\Ixen.Platform.csproj" />
	</ItemGroup>
</Project>
